<Window x:Class="SonicScrewdriver.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SonicScrewdriver.UI"
        Title="Sonic Screwdriver" Width="360" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Border CornerRadius="8" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Padding="14,10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyText" Text="No application is playing sound."
                       Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,2" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:DeviceViewModel}">
                            <StackPanel Margin="0,4,0,8">
                              <Border Background="{StaticResource DeviceRowBrush}" CornerRadius="6" Padding="10,7,10,2" Margin="0,0,0,4">
                               <StackPanel>
                                <!-- Device header: name, default marker / make-default button, volume -->
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Set as default" Style="{StaticResource LinkButton}"
                                            Click="SetDefault_Click" Tag="{Binding}" ToolTip="Make this the default output device">
                                        <Button.Visibility>
                                            <Binding Path="IsDefault" Converter="{StaticResource InverseBoolToVisibility}"/>
                                        </Button.Visibility>
                                    </Button>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" ToolTip="Default device"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource SubtleBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid Margin="0,4,0,6" Background="Transparent" ui:WheelVolume.Slider="{Binding ElementName=DeviceSlider}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}"/>
                                    <Slider x:Name="DeviceSlider" Grid.Column="1" Margin="8,0" Style="{StaticResource FlatSlider}" Value="{Binding Volume}"/>
                                    <TextBlock Grid.Column="2" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                               TextAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}}"/>
                                </Grid>
                               </StackPanel>
                              </Border>

                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:AppVolumeViewModel}">
                                          <Border Background="{StaticResource AppRowBrush}" CornerRadius="6" Padding="8,6,8,6" Margin="0,2">
                                            <Grid Background="Transparent" ToolTip="{Binding ExeName}"
                                                  ui:WheelVolume.Slider="{Binding ElementName=AppSlider}"
                                                  ContextMenuOpening="AppRow_ContextMenuOpening">
                                                <Grid.ContextMenu>
                                                    <ContextMenu/>
                                                </Grid.ContextMenu>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.RowSpan="2" Width="24" Height="24" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                               Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Icon}" Width="24" Height="24"/>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Grid Grid.Row="1" Grid.Column="1" Margin="4,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}"/>
                                                    <Slider x:Name="AppSlider" Grid.Column="1" Margin="6,0" Style="{StaticResource FlatSlider}" Value="{Binding Volume}"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                                           TextAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}}"/>
                                                <!-- What the app plays, with transport buttons (only with "Show what is playing") -->
                                                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,4,0,0" Padding="8,3,8,3"
                                                        Background="{StaticResource PlayingBrush}" CornerRadius="4"
                                                        Visibility="{Binding HasNowPlaying, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="&#xE100;" Style="{StaticResource LinkButton}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource FgBrush}"
                                                                Margin="6,0" Click="Previous_Click" Tag="{Binding}" ToolTip="Previous"/>
                                                        <Button Content="{Binding PlayGlyph}" Style="{StaticResource LinkButton}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource FgBrush}"
                                                                Margin="6,0" Click="PlayPause_Click" Tag="{Binding}" ToolTip="Play / Pause"/>
                                                        <Button Content="&#xE101;" Style="{StaticResource LinkButton}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource FgBrush}"
                                                                Margin="6,0,0,0" Click="Next_Click" Tag="{Binding}" ToolTip="Next"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding NowPlayingText}" Foreground="{StaticResource SubtleBrush}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding NowPlayingText}"/>
                                                </DockPanel>
                                                </Border>
                                            </Grid>
                                          </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Default microphone (only with "Show the microphone in the mixer") -->
                <Border x:Name="MicSection" Visibility="Collapsed" Margin="0,4,0,8" Background="{StaticResource DeviceRowBrush}" CornerRadius="6" Padding="10,7,10,2">
                  <StackPanel>
                    <TextBlock Text="{Binding Name, StringFormat=Microphone: {0}}" Foreground="{StaticResource SubtleBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,4,0,6" Background="Transparent" ui:WheelVolume.Slider="{Binding ElementName=MicSlider}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}"/>
                        <Slider x:Name="MicSlider" Grid.Column="1" Margin="8,0" Style="{StaticResource FlatSlider}" Value="{Binding Volume}"/>
                        <TextBlock Grid.Column="2" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center"
                                   TextAlignment="Right" Text="{Binding Volume, StringFormat={}{0:0}}"/>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
