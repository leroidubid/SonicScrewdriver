<Window x:Class="SonicScrewdriver.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonicScrewdriver OSD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" IsHitTestVisible="False">
    <Border CornerRadius="10" Background="#E61F1F1F" BorderBrush="#33FFFFFF" BorderThickness="1"
            Padding="16,12" MinWidth="240">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="Fallback" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="AppIcon" Width="32" Height="32"/>
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="320"/>
                <TextBlock x:Name="DetailText" Foreground="#CCFFFFFF" FontSize="22" Margin="0,2,0,0"/>
                <ProgressBar x:Name="Level" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"
                             Foreground="#0A84FF" Background="#33FFFFFF" BorderThickness="0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
