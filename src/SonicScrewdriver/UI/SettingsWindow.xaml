<Window x:Class="SonicScrewdriver.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SonicScrewdriver.UI"
        Title="Sonic Screwdriver — Settings" Width="720" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#18181A" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20,12,20,16">
        <StackPanel DockPanel.Dock="Bottom">
            <ItemsControl x:Name="ErrorList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource ErrorText}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="SavedText" Text="&#x2713; Saved" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                <Button x:Name="CancelButton" Content="Close" Style="{StaticResource FlatButton}" Padding="18,8" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource FlatButton}" Padding="22,8" Margin="0,0,8,0" Click="Save_Click"/>
                <Button x:Name="SaveExitButton" Content="Save &amp; exit" Style="{StaticResource FlatButton}" Padding="22,8" Background="{StaticResource AccentBrush}" Click="SaveExit_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TabControl x:Name="Tabs">
        <TabItem x:Name="TabShortcuts" Header="Shortcuts">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ShortcutsSection" Margin="0,12,12,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                       Text="Each row binds a modifier combination to an application or to the output devices. It applies to Vol+, Vol−, Mute, Play/Pause, Next and Previous. Keys pressed without a modifier keep their normal behavior."/>
                            <ItemsControl x:Name="RowsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RowBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Content="Ctrl" IsChecked="{Binding Ctrl}" Style="{StaticResource ChipToggle}"/>
                                                    <ToggleButton Content="Shift" IsChecked="{Binding Shift}" Style="{StaticResource ChipToggle}"/>
                                                    <ToggleButton Content="Alt" IsChecked="{Binding Alt}" Style="{StaticResource ChipToggle}"/>
                                                    <ToggleButton Content="Win" IsChecked="{Binding Win}" Style="{StaticResource ChipToggle}"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" IsEditable="True" Margin="6,0,10,0" Height="32"
                                                          ItemsSource="{Binding DataContext.TargetChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="&quot;Foreground app&quot; or an executable name, e.g. spotify.exe"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Volume step per key press">
                                                    <TextBox Width="48" Height="32" HorizontalContentAlignment="Center"
                                                             Text="{Binding StepPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="%" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Remove" Width="32" Height="32"
                                                        Padding="0" Style="{StaticResource FlatButton}" Click="Remove_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left" Content="+ Add shortcut" Style="{StaticResource FlatButton}" Click="Add_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Free shortcuts" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                       Text="A shortcut on any key combination, not only on media keys: click the box, press the combination (at least one of Ctrl, Alt, Shift or Win, plus a key), then choose what it does and to which app. Windows itself matches the combination (no keyboard hook), so its keys are taken from other programs while Sonic Screwdriver runs. A combination already used by Windows or another program is refused. Off in competitive mode."/>
                            <StackPanel x:Name="FreePanel"/>
                            <Button HorizontalAlignment="Left" Content="+ Add free shortcut" Style="{StaticResource FlatButton}" Click="AddFree_Click"/>
                            <TextBlock x:Name="FreeError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Output devices in the cycle" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="With an &quot;Output device&quot; shortcut, Vol+ / Vol− switch the default output through the ticked devices."/>
                            <ItemsControl ItemsSource="{Binding CycleDevices}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Margin="0,5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Media keys" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="For keyboards without media keys: choose which key acts as each one. A remapped key works like the real media key, with the same shortcuts (Shift + your key turns down the app bound to Shift), and keeps the normal behavior of the real key when no shortcut applies. Click a box, then press the key. Remapped keys lose their usual job while Sonic Screwdriver runs (F12 no longer opens the browser developer tools). Typing keys cannot be used."/>
                            <StackPanel x:Name="RemapPanel" Margin="0,10,0,0"/>
                            <TextBlock x:Name="RemapError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="TabAudio" Header="Audio">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,12,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Volume profiles" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                   Text="A named set of app volumes, for example Game night: Discord 80, music 30, browser 10. Apply it from the tray menu, a shortcut, the command line (--profile) or when a program starts. Apps that are not playing are skipped. Use &quot;+ Add running apps&quot; to capture the current levels. The shortcut and the start-with-program trigger are off in competitive mode."/>
                        <StackPanel x:Name="ProfilePanel"/>
                        <Button HorizontalAlignment="Left" Content="+ Add profile" Style="{StaticResource FlatButton}" Click="AddProfile_Click"/>
                    </StackPanel>
                </Border>

                    <Border Style="{StaticResource Card}" Tag="Dim">
                        <StackPanel>
                            <TextBlock Text="Mute everything" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="One shortcut mutes every app (apps hidden from the mixer excepted); the next press puts each one back exactly as it was. Each app is muted on its own: the Windows master volume and the levels are not touched. Off in competitive mode."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:KeyCaptureBox x:Name="MuteAllBox" Chord="True" Width="220" Height="32" Style="{StaticResource {x:Type TextBox}}"/>
                                <Button Content="Clear" Style="{StaticResource FlatButton}" Padding="14,6" Margin="8,0,0,0" Click="ClearMuteAll_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MuteAllError" Style="{StaticResource ErrorText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Tag="Dim">
                        <StackPanel>
                            <TextBlock Text="Microphone" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="One shortcut mutes and unmutes the default microphone (with the on-screen display; the tray icon turns grey while it is muted). The volume and mute of the microphone can also be shown at the bottom of the mixer. Both follow the microphone through Windows notifications while one of them is on, and stop in competitive mode."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:KeyCaptureBox x:Name="MicBox" Chord="True" Width="220" Height="32" Style="{StaticResource {x:Type TextBox}}"/>
                                <Button Content="Clear" Style="{StaticResource FlatButton}" Padding="14,6" Margin="8,0,0,0" Click="ClearMic_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MicError" Style="{StaticResource ErrorText}"/>
                            <CheckBox x:Name="MicMixerBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                      Content="Show the microphone in the mixer"/>
                        </StackPanel>
                    </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Automatic ducking" Style="{StaticResource CardTitle}"/>
                        <CheckBox x:Name="DuckBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                  Content="Lower other apps while a voice app speaks"/>
                        <TextBlock x:Name="DuckHint" Style="{StaticResource Hint}" Margin="0,4,0,8"
                                   Text="Off by default. Mark the voice apps (Discord, Teams...) and the apps to lower. Speech is detected from the voice app's sound level; the others go down to the chosen level, then return to exactly what they were. A slider you move while they are lowered is respected. The level is read about ten times a second, only while a voice app has a session; it stops in competitive mode."/>
                        <StackPanel x:Name="DuckSettingsPanel">
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Lower to" Width="170" VerticalAlignment="Center"/>
                                <TextBox x:Name="DuckToBox" Width="56" Height="32" HorizontalContentAlignment="Center" ToolTip="Percent of their level (0-100)"/>
                                <TextBlock Text="% of their level" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Speaking threshold" Width="170" VerticalAlignment="Center"/>
                                <TextBox x:Name="DuckThresholdBox" Width="56" Height="32" HorizontalContentAlignment="Center" ToolTip="Peak level of the voice app that counts as speaking (1-50)"/>
                                <TextBlock Text="% peak level" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Reaction delay" Width="170" VerticalAlignment="Center"/>
                                <TextBox x:Name="DuckAttackBox" Width="64" Height="32" HorizontalContentAlignment="Center" ToolTip="Speech must last this long before lowering (0-2000 ms)"/>
                                <TextBlock Text="ms" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                                <TextBlock Text="Release delay" Width="170" VerticalAlignment="Center"/>
                                <TextBox x:Name="DuckReleaseBox" Width="64" Height="32" HorizontalContentAlignment="Center" ToolTip="Silence must last this long before raising again (200-10000 ms)"/>
                                <TextBlock Text="ms" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="DuckPanel"/>
                            <Button HorizontalAlignment="Left" Content="+ Add app" Style="{StaticResource FlatButton}" Click="AddDuck_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="Streamer mode" Style="{StaticResource CardTitle}"/>
        <CheckBox x:Name="StreamBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Content="Lower other apps while I speak"/>
        <TextBlock x:Name="StreamHint" Style="{StaticResource Hint}" Margin="0,4,0,8"
                   Text="The reverse of ducking. Off by default. Tick the apps to lower (a game, music...): while you speak into the default microphone they go down to the chosen share of their level, then return to exactly what they were. A slider you move while they are lowered is respected. The microphone level is read about ten times a second, only while the mode is on and an app is ticked; it stops in competitive mode."/>
        <StackPanel x:Name="StreamSettingsPanel">
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Lower to" Width="170" VerticalAlignment="Center"/>
                <TextBox x:Name="StreamToBox" Width="56" Height="32" HorizontalContentAlignment="Center" ToolTip="Percent of their level (0-100)"/>
                <TextBlock Text="% of their level" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Speaking threshold" Width="170" VerticalAlignment="Center"/>
                <TextBox x:Name="StreamThresholdBox" Width="56" Height="32" HorizontalContentAlignment="Center" ToolTip="Peak level of the microphone that counts as speaking (1-50): raise it if room noise triggers it"/>
                <TextBlock Text="% peak level" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Reaction delay" Width="170" VerticalAlignment="Center"/>
                <TextBox x:Name="StreamAttackBox" Width="64" Height="32" HorizontalContentAlignment="Center" ToolTip="Speech must last this long before lowering (0-2000 ms)"/>
                <TextBlock Text="ms" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                <TextBlock Text="Release delay" Width="170" VerticalAlignment="Center"/>
                <TextBox x:Name="StreamReleaseBox" Width="64" Height="32" HorizontalContentAlignment="Center" ToolTip="Silence must last this long before raising again (200-10000 ms)"/>
                <TextBlock Text="ms" Foreground="{StaticResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="StreamPanel"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Add app" Style="{StaticResource FlatButton}" Click="AddStream_Click"/>
                <Button Content="+ Add running apps" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="AddStreamRunning_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Maximum volume per app" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                                   Text="A cap for an app, for example a browser at 40 %. The mixer slider, the shortcuts and the commands stop at it, and an app that goes above it by itself is brought back (that check stops in competitive mode). Pick a running app or type an executable name."/>
                        <StackPanel x:Name="LimitPanel"/>
                        <Button HorizontalAlignment="Left" Content="+ Add limit" Style="{StaticResource FlatButton}" Click="AddLimit_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Remembered routing" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="RoutingHint" Style="{StaticResource Hint}" Margin="0,4,0,12"
                                   Text="An app that always plays on the same output, for example Discord on the headset and Spotify on the speakers. The rule is applied when the app's sound starts (an output you chose by hand stays until the app restarts); a device that is not plugged in is skipped. Uses the same Windows setting as the mixer's right-click menu. Off in competitive mode."/>
                        <StackPanel x:Name="RoutingPanel"/>
                        <Button x:Name="AddRoutingButton" HorizontalAlignment="Left" Content="+ Add rule" Style="{StaticResource FlatButton}" Click="AddRouting_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Output device priority" Style="{StaticResource CardTitle}"/>
                        <CheckBox x:Name="PriorityBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                  Content="Choose the default output from this list"/>
                        <TextBlock x:Name="PriorityHint" Style="{StaticResource Hint}" Margin="0,4,0,12"
                                   Text="Devices from most to least wanted (headset, then speakers, then monitor). When devices are plugged in or removed, the default output becomes the first one of the list that is plugged in. An output you pick by hand is kept until the first plugged-in device of the list changes. This list is separate from the Output device cycle. Off in competitive mode."/>
                        <StackPanel x:Name="PriorityPanel"/>
                        <StackPanel x:Name="PriorityAddRow" Orientation="Horizontal" Margin="0,4,0,0">
                            <ComboBox x:Name="PriorityChoice" Width="260" Height="32" DisplayMemberPath="Label"/>
                            <Button Content="+ Add device" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="AddPriority_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="Now playing" Style="{StaticResource CardTitle}"/>
        <CheckBox x:Name="NowPlayingBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Content="Show what is playing in the mixer"/>
        <TextBlock x:Name="NowPlayingHint" Style="{StaticResource Hint}"
                   Text="Title and artist under each app, with Previous, Play/Pause and Next buttons. Read from the Windows media sessions only while the mixer is open. Off in competitive mode."/>
    </StackPanel>
</Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="TabGeneral" Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,12,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Competitive mode" Style="{StaticResource CardTitle}"/>
                        <CheckBox x:Name="CompetitiveBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                  Checked="Competitive_Changed" Unchecked="Competitive_Changed" Content="Anti-cheat friendly"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Turns off the keyboard shortcuts, the on-screen display, the mouse wheel on the tray icon, and app icons and names, so that nothing here can be mistaken for cheating software. The mixer, sliders and output switching keep working. This lowers the risk but is no guarantee: quitting the app is safer. The shortcuts above are greyed out while it is on."/>

                        <TextBlock Text="Shortcut to switch it on or off" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:KeyCaptureBox x:Name="ModeHotkeyBox" Chord="True" Width="220" Height="32" Style="{StaticResource {x:Type TextBox}}"/>
                            <Button Content="Clear" Style="{StaticResource FlatButton}" Padding="14,6" Margin="8,0,0,0" Click="ClearModeHotkey_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Click the box, then press the combination (at least one of Ctrl, Alt, Shift or Win, plus a key). It is the one shortcut that still works while the mode is on, and it does not use the keyboard hook: Windows itself matches the combination and tells this app, so no other key is seen. A short notification confirms each switch."/>
                        <TextBlock x:Name="HotkeyError" Style="{StaticResource ErrorText}"/>

                        <TextBlock Text="Switch on automatically" Style="{StaticResource Label}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Off by default. Add the games to protect: while a ticked program runs, competitive mode turns on, and it turns off again when the program exits (unless you switched it by hand). A program is spotted by its name in the process list, checked every few seconds without opening it. Nothing is polled while the list has no ticked program."/>
                        <ItemsControl x:Name="AutoList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled}" ToolTip="Turn competitive mode on while this program runs" Margin="0,0,10,0"/>
                                            <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,10,0" Height="32"
                                                      ItemsSource="{Binding DataContext.AutoChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding ExeText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Executable name, e.g. valorant.exe"/>
                                            <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Remove" Width="32" Height="32"
                                                    Padding="0" Style="{StaticResource FlatButton}" Click="RemoveAuto_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Left" Content="+ Add program" Style="{StaticResource FlatButton}" Click="AddAuto_Click" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="General" Style="{StaticResource CardTitle}"/>
        <CheckBox x:Name="StartupBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Content="Start with Windows"/>
    </StackPanel>
</Border>

<Border Style="{StaticResource Card}">
    <StackPanel>
        <TextBlock Text="Updates" Style="{StaticResource CardTitle}"/>
        <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Hint}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CheckUpdateButton" Content="Check for updates" Style="{StaticResource FlatButton}" Padding="14,6" Click="CheckUpdate_Click"/>
            <Button x:Name="InstallUpdateButton" Content="Install" Style="{StaticResource FlatButton}" Padding="14,6" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
        </StackPanel>
        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}"/>
        <CheckBox x:Name="UpdatesAtStartBox" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Left" Margin="0,12,0,0"
                  Content="Check at startup"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Off by default: the app makes no network request on its own. A check asks GitHub for the latest release (your address is visible to GitHub, nothing else is sent). Installing downloads the installer of that release, checks its SHA256 against the one published with it, then closes the app, updates it and starts it again. A copy that was not set up by the installer (portable exe) is replaced in place instead. Nothing runs in competitive mode. Unsaved changes in this window are lost."/>
    </StackPanel>
</Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hidden apps" Style="{StaticResource CardTitle}"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Apps hidden from the mixer (right-click an app there). They keep working with shortcuts and their volume is not touched."/>
                        <TextBlock x:Name="HiddenEmpty" Style="{StaticResource Hint}" Text="No hidden app." Margin="0,8,0,0"/>
                        <ItemsControl x:Name="HiddenList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Show again" Style="{StaticResource FlatButton}" Padding="14,6"
                                                    Click="ShowAgain_Click" Tag="{Binding}"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
