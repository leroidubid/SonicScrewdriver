<Window x:Class="SonicScrewdriver.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonic Screwdriver — Shortcuts" Width="680" Height="560" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#1F1F1F" Foreground="White">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Modifier shortcuts" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#B3FFFFFF" Margin="0,4,0,0"
                       Text="Each row binds a modifier combination to an application or to the output devices. It applies to Vol+, Vol−, Mute, Play/Pause, Next and Previous. Keys pressed without a modifier keep their normal behavior."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="Output devices in the cycle" FontWeight="SemiBold" Margin="0,12,0,2"/>
            <TextBlock TextWrapping="Wrap" Foreground="#B3FFFFFF" FontSize="11"
                       Text="With an &quot;Output device&quot; shortcut, Vol+ / Vol− switch the default output through these devices."/>
            <ItemsControl ItemsSource="{Binding CycleDevices}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="ErrorList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FF6B6B"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,12,0,0">
                <CheckBox x:Name="StartupBox" Content="Start with Windows" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="Save" Style="{StaticResource FlatButton}" Background="{StaticResource AccentBrush}" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Modifiers" Foreground="#B3FFFFFF"/>
            <TextBlock Grid.Column="1" Text="Target application" Foreground="#B3FFFFFF"/>
            <TextBlock Grid.Column="2" Text="Step (%)" Foreground="#B3FFFFFF"/>
        </Grid>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="+ Add shortcut"
                Style="{StaticResource FlatButton}" Click="Add_Click" Margin="0,8,0,0"/>

        <Border Background="#2B2B2B" CornerRadius="6" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}"/>
                                    <CheckBox Content="Shift" IsChecked="{Binding Shift}"/>
                                    <CheckBox Content="Alt" IsChecked="{Binding Alt}"/>
                                    <CheckBox Content="Win" IsChecked="{Binding Win}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,8,0"
                                          ItemsSource="{Binding DataContext.TargetChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="&quot;Foreground app&quot; or an executable name, e.g. spotify.exe"/>
                                <TextBox Grid.Column="2" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         Text="{Binding StepPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="Remove"
                                        Style="{StaticResource FlatButton}" Padding="6" Click="Remove_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
